#!/usr/bin/env bash
# pre-push : rustfmt + clippy sur les fichiers/paquets RÉELLEMENT modifiés.
# La CI reste l'autorité sur toute la workspace. Ce hook doit être rapide et
# ne jamais bloquer un push pour du code que le push n'a pas touché — mesuré
# deux fois le 10/11/2026 : un fichier non formaté d'un autre agent, puis un
# clippy::result_large_err dans le paquet racine que nos branches n'ont pas touché.
set -euo pipefail

base=$(git merge-base origin/main HEAD 2>/dev/null || echo HEAD)

echo "── rustfmt (fichiers modifiés) ──"
fmt_files=$(git diff --name-only "$base" HEAD -- '*.rs')
if [ -n "$fmt_files" ]; then
  echo "$fmt_files" | xargs rustfmt --edition 2024 --check
fi

echo "── clippy (paquets modifiés) ──"
pkgs=$(git diff --name-only "$base" HEAD -- '*.rs' | while read -r f; do
  d=$(dirname "$f")
  while [ "$d" != "." ] && [ ! -f "$d/Cargo.toml" ]; do d=$(dirname "$d"); done
  [ -f "$d/Cargo.toml" ] && printf '%s\n' "$d"
done | sort -u)

for d in $pkgs; do
  echo "  clippy --manifest-path $d/Cargo.toml"
  cargo clippy --manifest-path "$d/Cargo.toml" --all-targets --all-features -- -D warnings
done

echo "✅ Pre-push checks passed."

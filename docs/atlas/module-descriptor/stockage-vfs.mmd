flowchart TB
%% name: module-descriptor-vfs-storage
%% PROUVE : banc vfs_conformance_* (memoire, fs), obrain_vfs_conformance (--features obrain), fs_vfs_sandboxed,
%%   obrain_vfs_survives_reopen_without_rebuild, module_store_* (put/get/bundles/immuable/yank/remove/assets), read_source_loads_stored_module.
%% SOURCES LUES : src/storage/vfs/{mod,memory,fs,obrain,module_store,conformance}.rs, src/storage/obrain.rs,
%%   src/server/module_runtime/loader.rs, crates/this-descriptor/src/{check,compat,module,i18n}.rs.
%% NON ETABLI : ecritures concurrentes entre PROCESSUS (verrou en processus seulement) ; ModuleRuntime branche sur read_source (flux modules-runtime).
    ADM(["Admin : put / yank / remove<br/>politique this.module.load"]):::entry
    RT["🟠 ModuleRuntime / ModuleLoader<br/>flux modules-runtime"]:::todo

    subgraph MS["VfsModuleStore - module_store.rs"]
        direction TB
        CHK["✅ check Stored + bundles<br/>module, syntaxe, espace de cles"]:::ok
        CMP["✅ check_compat contre TOUTES les versions<br/>+ tags reserves (trou de check_compat)"]:::ok
        IMM["✅ version immuable<br/>meme contenu = idempotent, sinon 409 Aborted"]:::ok
        MAN["✅ manifest.json ecrit en dernier IfNoneMatch<br/>= marqueur de commit + etags"]:::ok
        YNK["✅ yank / unyank : retour arriere<br/>sans toucher l'arbre de la version"]:::ok
        RD["✅ get / bundle / asset<br/>etag verifie contre le manifeste, re-check Stored"]:::ok
    end

    subgraph V["trait Vfs - semantique commune, banc conformance.rs"]
        direction LR
        MEM["✅ InMemoryVfs<br/>BTreeMap sous un verrou"]:::ok
        FS["✅ LocalFsVfs<br/>refus des liens symboliques,<br/>tmp + fsync + rename"]:::ok
        OB["✅ ObrainVfs feature obrain<br/>un noeud _vfs_file par fichier"]:::ok
    end

    TRAP["⚠ index uuid vers NodeId d'ObrainStore<br/>perdus a open : ObrainVfs ne garde<br/>AUCUN index, balayage du label"]:::trap
    RACE["⚠ deux processus sur la meme version :<br/>fichiers ecrases avant l'echec du commit,<br/>detecte par les etags, jamais servi"]:::trap
    DB@{ shape: cyl, label: "substrat obrain<br/>commit_wal a chaque mutation" }
    DISK@{ shape: cyl, label: "repertoire local" }

    ADM ==> CHK ==> CMP ==> IMM ==> MAN
    ADM --> YNK
    RT ==>|"read_source : descripteur + bundles"| RD
    MAN --> V
    RD --> V
    YNK --> V
    FS --> DISK
    OB --> DB
    OB -.- TRAP
    MAN -.- RACE

    classDef ok       fill:#2ea04333,stroke:#2ea043,stroke-width:2px
    classDef todo     fill:#f0a02033,stroke:#d98a00,stroke-width:2px
    classDef refused  fill:#e5484d33,stroke:#e5484d,stroke-width:2px,stroke-dasharray:6 3
    classDef upstream fill:#8b8fa322,stroke:#8b8fa3,stroke-dasharray:3 3
    classDef trap     fill:#e5484d1f,stroke:#e5484d,stroke-width:3px
    classDef entry    fill:#a48bff40,stroke:#a48bff,stroke-width:3px

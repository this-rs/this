flowchart TB
    classDef ok       fill:#2ea04333,stroke:#2ea043,stroke-width:2px
    classDef todo     fill:#f0a02033,stroke:#d98a00,stroke-width:2px
    classDef refused  fill:#e5484d33,stroke:#e5484d,stroke-width:2px,stroke-dasharray:6 3
    classDef upstream fill:#8b8fa322,stroke:#8b8fa3,stroke-dasharray:3 3
    classDef trap     fill:#e5484d1f,stroke:#e5484d,stroke-width:3px
    classDef entry    fill:#a48bff40,stroke:#a48bff,stroke-width:3px

    ADM(["Admin : put / yank / remove<br/>politique this.module.load"]):::entry
    RT["✅ ModuleRuntime / DefaultModuleLoader<br/>read_source, bundles verifies avant publication<br/>e2e hot_loaded_module_from_vfs"]:::ok

    subgraph MS["VfsModuleStore - module_store.rs"]
        direction TB
        CHK["✅ check Stored + bundles + assets<br/>module, syntaxe, cles, locale declaree"]:::ok
        CMP["✅ check_compat contre TOUTES les versions<br/>backport verifie contre les superieures"]:::ok
        IMM["✅ version immuable<br/>meme contenu = idempotent, sinon 409 Aborted"]:::ok
        MAN["✅ orphelins purges, fichiers, puis manifest.json<br/>IfNoneMatch = marqueur de commit"]:::ok
        YNK["✅ yank / unyank : retour arriere"]:::ok
        RD["✅ get / bundle / asset<br/>etag verifie, re-check Stored"]:::ok
    end

    subgraph V["trait Vfs - banc conformance.rs"]
        direction LR
        MEM["✅ InMemoryVfs"]:::ok
        FS["✅ LocalFsVfs<br/>refus des liens symboliques,<br/>tmp + fsync + rename"]:::ok
        OB["✅ ObrainVfs feature obrain<br/>un noeud _vfs_file par fichier,<br/>graphe RACINE"]:::ok
    end

    TRAP["⚠ index uuid vers NodeId d'ObrainStore<br/>perdus a open : ObrainVfs ne garde<br/>AUCUN index, balayage du label"]:::trap
    RACE["🟠 deux processus sur la meme version :<br/>pas de verrou inter-processus,<br/>detecte par les etags, jamais servi"]:::todo
    DB@{ shape: cyl, label: "substrat obrain<br/>commit_wal a chaque mutation" }
    DISK@{ shape: cyl, label: "repertoire local" }

    ADM ==> CHK ==> CMP ==> IMM ==> MAN

sequenceDiagram
%% name: module-descriptor-runtime-load
%% PROUVE (flux modules-runtime, tests/module_runtime.rs, cargo test -p this-rs --test module_runtime : 11 ok) :
%%   load_then_routes_served_unload_then_404, unload_refused_with_active_dependents,
%%   replace_checks_dependents_version_req, draining_times_out_and_cancels_streams,
%%   dynamic_module_paths_not_shadowed_by_link_wildcards, json_entity_publishes_event_and_links,
%%   admin_interface_requires_admin_then_lists_loads_unloads, plugin_source_is_an_extension_point.
%% SOURCES LUES : src/server/module_runtime/{runtime,dispatch,admin,loader,json_entity}.rs,
%%   src/server/exposure/rest/mod.rs (ModuleRuntime::mount), src/server/catalog.rs, crates/this-descriptor/src/resolve.rs.
%% NON ETABLI : GraphQL et gRPC ne lisent pas encore le catalogue (flux auth) ; un module charge a chaud
%%   n'y est pas servi. Pas de chargement WASM reel (wasmtime absent) : point d'extension ModuleSource::Plugin.
    autonumber
    actor Admin
    participant AU as Authentification
    participant ADM as Interface admin
    participant RT as ModuleRuntime
    participant LD as DefaultModuleLoader
    participant RES as resolve
    participant CAT as LiveCatalog
    participant DSP as Couche de repartition
    participant BUS as EventBus

    Admin->>AU: POST /admin/modules manifest
    AU->>ADM: AuthContext
    ADM->>ADM: politique admin_only, evaluate du descripteur
    alt anonyme ou non admin
        ADM-->>Admin: 401 this.auth.unauthenticated ou 403 this.auth.forbidden
    end
    ADM->>RT: load Manifest
    rect rgba(164,139,255,.15)
    Note over RT,LD: Phase 1 - lecture et verification, verrou ops tenu
    RT->>LD: load source
    LD->>LD: check profil Stored, politiques explicites
    LD-->>RT: ModuleInterface, JsonEntityService par entite
    end
    rect rgba(164,139,255,.15)
    Note over RT,RES: Phase 2 - resolution fail-closed contre les modules actifs
    RT->>RES: candidat vs actifs
    alt dependance, version, cycle, doublon, reference
        RES-->>RT: this.module.*
        RT->>BUS: Module Failed
        RT-->>Admin: erreur, etat Failed, rien n'est publie
    else ok
        RES-->>RT: ordre
    end
    end
    rect rgba(164,139,255,.15)
    Note over RT,DSP: Phase 3 - composition base + modules actifs, merge_strict
    RT->>CAT: publish HostCatalog generation+1
    RT->>DSP: store DispatchTable
    RT->>BUS: Module Loaded
    RT-->>Admin: 201 active
    end
    Admin->>RT: DELETE /admin/modules/billing
    alt dependants actifs ou module compile dans l'hote
        RT-->>Admin: 412 this.module.has_dependents, reste Active
    else aucun
        RT->>DSP: Draining, nouvelles requetes 503 this.module.unavailable
        Note over RT,DSP: attente des requetes en vol, grace 30 s, puis ModuleCancellation
        RT->>CAT: publish sans billing
        RT->>DSP: tombstone, 404 this.module.not_found
        RT->>BUS: Module Unloaded
        RT-->>Admin: 200 unloaded
    end

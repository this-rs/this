classDiagram
%% name: module-descriptor-classes
%% PROUVE : rien encore — c'est le CONTRAT propose par docs/rfc/module-descriptor.md §3.2 (crate this-descriptor), pas du code existant.
%% SOURCES LUES : this/src/server/entity_registry.rs (EntityDescriptor sans champs), this/src/core/module.rs (trait Module),
%%   this/src/core/validation/config.rs + entities/macros.rs (grammaire validate/filters), this/src/core/auth/mod.rs (AuthPolicy),
%%   this/src/core/query.rs (QueryParams), this/src/core/link.rs (LinkDefinition).
%% NON ETABLI : non compile ; les noms peuvent bouger pendant le flux fondation.
    direction LR
    class ModuleDescriptor {
        +u32 format
        +String name
        +String version
        +Vec~ModuleReq~ requires
        +Vec~EntityDesc~ entities
        +Vec~LinkDesc~ links
        +Vec~ErrorDesc~ errors
        +I18nCatalog i18n
        +Vec~Custom~ custom
        +check(CustomRegistry) Result
    }
    class ModuleReq {
        +String name
        +String version
        +bool optional
    }
    class EntityDesc {
        +String name
        +String plural
        +EntityKind kind
        +Vec~FieldDesc~ fields
        +Vec~u32~ reserved_tags
        +PermDesc permissions
        +EntityI18n i18n
    }
    class FieldDesc {
        +String name
        +FieldType ty
        +bool optional
        +u32 proto_tag
        +Vec~ValidatorRule~ validators
        +Vec~TransformRule~ filters
        +Vec~FilterOp~ filterable
        +bool sortable
        +FieldI18n i18n
        +bool read_only
    }
    class LinkDesc {
        +String link_type
        +String source
        +String target
        +String forward_route
        +String reverse_route
        +Vec~FieldDesc~ fields
        +PermDesc permissions
    }
    class ErrorDesc {
        +ErrorCode code
        +ErrorKind kind
        +MessageKey message_key
        +Vec~String~ params
    }
    class ContractError {
        +ErrorCode code
        +ErrorKind kind
        +MessageKey message_key
        +String message
        +Map params
        +Vec~FieldViolation~ fields
        +http_body() Value
    }
    class ErrorKind {
        <<enumeration>>
        Validation
        PermissionDenied
        NotFound
        Internal
        +http_status() u16
        +grpc_code() i32
        +graphql_code() str
    }
    class PermDesc {
        +Map~Operation,PolicyExpr~ ops
        +policy(Operation) PolicyExpr
    }
    class PolicyExpr {
        <<enumeration>>
        Public
        Authenticated
        HasRole
        And_Or_Not
        Resolver
    }
    class I18nCatalog {
        +Locale default_locale
        +Map messages
    }
    class Query~T~ {
        +Option~FilterExpr~ filter
        +Vec~SortSpec~ sort
        +Page page
    }
    class Custom {
        +String name
        +Value params
    }
    class Described {
        <<interface>>
        +entity_desc() EntityDesc
    }
    ModuleDescriptor "1" *-- "*" ModuleReq : requires
    ModuleDescriptor "1" *-- "*" EntityDesc
    ModuleDescriptor "1" *-- "*" LinkDesc
    ModuleDescriptor "1" *-- "*" ErrorDesc
    ModuleDescriptor "1" *-- "1" I18nCatalog
    EntityDesc "1" *-- "*" FieldDesc
    EntityDesc "1" *-- "1" PermDesc
    LinkDesc "1" *-- "*" FieldDesc
    LinkDesc "1" *-- "1" PermDesc
    PermDesc --> PolicyExpr
    ErrorDesc --> ErrorKind
    ContractError --> ErrorKind
    ContractError ..> ErrorDesc : instancie
    Query~T~ ..> FieldDesc : verifie filterable et sortable
    FieldDesc ..> Custom : extension nommee
    Described ..> EntityDesc : macro impl_data_entity

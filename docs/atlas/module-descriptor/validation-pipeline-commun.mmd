flowchart LR
%% name: module-descriptor-validation-pipeline
%% PROUVE (flux validation, md/validation) : une ecriture d'entite DECRITE passe par engine::validate sur REST, GraphQL et gRPC ;
%%   meme code this.validation.positive sur les trois (same_invalid_payload_same_code_on_rest_graphql_grpc) ; store jamais atteint ;
%%   filtre et tri types appliques avant pagination en REST (ListQuery), GraphQL (args filter/sort) et gRPC (metadonnees this-filter/this-sort).
%% REVUE (0c8b4c9) : variables GraphQL inlinees avant resolution (graphql_variables_reach_validation_and_filters) ; sort non chaine = malformed_sort ;
%%   metadonnees gRPC illisibles = INVALID_ARGUMENT, valeurs UTF-8 via this-filter-bin (grpc_filter_bin_metadata_and_unreadable_value_refused) ; update refuse en GraphQL et gRPC.
%% SOURCES LUES : src/core/validation/{gate,layer,extractor,config}.rs, src/core/query.rs, src/server/host.rs,
%%   src/server/exposure/{rest/mod.rs,graphql/mod.rs,graphql/executor/query_executor.rs,grpc/entity_service.rs}, crates/this-descriptor/src/engine/{validate,query}.rs.
%% NON ETABLI : WebSocket n'ecrit pas d'entite (aucun appel create_from_json sous websocket/) ; handlers REST de liens (links/handlers.rs) gardent filter_value laxiste (flux integration) ;
%%   chemin dynamic_schema GraphQL valide via les createurs mais son rendu d'erreur n'est pas teste.
    classDef ok       fill:#2ea04333,stroke:#2ea043,stroke-width:2px
    classDef todo     fill:#f0a02033,stroke:#d98a00,stroke-width:2px
    classDef refused  fill:#e5484d33,stroke:#e5484d,stroke-width:2px,stroke-dasharray:6 3
    classDef upstream fill:#8b8fa322,stroke:#8b8fa3,stroke-dasharray:3 3
    classDef trap     fill:#e5484d1f,stroke:#e5484d,stroke-width:3px
    classDef entry    fill:#a48bff40,stroke:#a48bff,stroke-width:3px

    RESTIN(["REST POST /plural<br/>PUT PATCH /plural/id<br/>GET /plural"]):::entry
    GQLIN(["GraphQL mutation createX updateX<br/>query xs filter sort<br/>variables inlinees"]):::entry
    GRPCIN(["gRPC CreateEntity UpdateEntity<br/>ListEntities + metadonnees<br/>this-filter ou this-filter-bin"]):::entry

    subgraph HOST["ServerHost::with_descriptors"]
        direction TB
        WRAP["✅ wrap_creators<br/>entites decrites seulement<br/>entity_creators = catalog.creators"]:::ok
        REG["✅ validation_registry<br/>ArcSwap CustomRegistry"]:::ok
    end

    subgraph CORE["core/validation"]
        direction TB
        LAYER["✅ layer::validation_middleware<br/>sous l'autorisation<br/>corps remplace par la valeur transformee"]:::ok
        GATE["✅ gate::ValidatingCreator<br/>create = Create, update = Update<br/>erreur = ContractError dans anyhow"]:::ok
        SHIM["✅ Validated T<br/>EngineValidated : extrait seulement<br/>sinon regles legacy + corps additif"]:::ok
        LQ["✅ core::query::ListQuery<br/>query_from_args, to_query"]:::ok
    end

    subgraph ENG["this-descriptor, wasm32"]
        direction TB
        APPLY["✅ engine::validate::apply<br/>cles, transforms, presence, type, validateurs"]:::ok
        QE["✅ engine::query<br/>parse strict, check, apply_in_memory"]:::ok
    end

    STORE@{ shape: cyl, label: "Store / EntityFetcher::list_query" }
    LEGACY["⚪ entite sans descripteur<br/>createur et handlers inchanges"]:::upstream
    LINKS["⚠ links/handlers.rs<br/>filter_value laxiste, refus de creation<br/>sans code, flux integration"]:::trap

    RESTIN ==> LAYER
    LAYER ==>|"ecriture"| APPLY
    LAYER ==>|"liste"| QE
    LAYER --> SHIM
    LAYER --> LQ
    GQLIN ==> GATE
    GRPCIN ==> GATE
    GQLIN ==>|"filter sort"| LQ
    GRPCIN ==>|"this-filter this-sort"| LQ
    WRAP --> GATE
    REG --> GATE
    REG --> LAYER
    GATE ==> APPLY
    LQ ==> QE
    APPLY ==>|"Ok valeur transformee"| STORE
    QE ==> STORE
    APPLY -.->|"Err 422 INVALID_ARGUMENT BAD_USER_INPUT"| RESTIN
    WRAP -.-> LEGACY
    LQ -.->|"non branche"| LINKS

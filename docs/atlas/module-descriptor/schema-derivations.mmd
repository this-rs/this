%% name: module-descriptor-schema-derivations
%% QUESTION : d'ou viennent SDL, .proto, JSON Schema et OpenAPI, et qui les sert ?
%% PROUVE (flux schema, branche md/schema, fusionnee sans conflit sur integ) : derive graphql / proto / json_schema / openapi (cargo test -p this-descriptor --all-features, 88 tests),
%%   generateurs this-rs descripteur d'abord + repli sample, cache SDL, routes /_this (cargo test -p this-rs --lib --features graphql,grpc, 1218 tests).
%% SOURCES LUES : crates/this-descriptor/src/{derive,entity,field,module}.rs, src/server/exposure/{graphql/schema_generator,grpc/proto_generator,rest/mod}.rs, src/entities/macros.rs.
%% RELECTURE (md/schema) : required = regle du moteur (derive_required_matches_engine), tags hors plage refuses (proto_refuses_out_of_range_tags), overlays gardent le tag de base, SDL validee par graphql_parser (described_sdl_parses_with_graphql_parser), /_this juge Descriptor read authenticated (descriptor_export_requires_authentication).
%% LU (revue finale) : this-cli/src/descriptor/mod.rs : read_lock().apply dans export, MODULE_DESCRIPTOR_FN (Module::descriptor engendre) compose SANS lock.
%% NON ETABLI : fil gRPC type (le fil servi reste Struct) ; this descriptor export --format proto|graphql|json-schema sans test CLI ; modules charges a chaud absents de entity_types.
flowchart LR
    classDef ok       fill:#2ea04333,stroke:#2ea043,stroke-width:2px
    classDef todo     fill:#f0a02033,stroke:#d98a00,stroke-width:2px
    classDef refused  fill:#e5484d33,stroke:#e5484d,stroke-width:2px,stroke-dasharray:6 3
    classDef upstream fill:#8b8fa322,stroke:#8b8fa3,stroke-dasharray:3 3
    classDef trap     fill:#e5484d1f,stroke:#e5484d,stroke-width:3px
    classDef entry    fill:#a48bff40,stroke:#a48bff,stroke-width:3px

    MAC(["impl_data_entity!<br/>Described, aucun tag"]):::entry
    LOCK(["descriptor.lock<br/>champ vers tag"]):::entry
    SET["✅ DescriptorSet publie<br/>Arc immuable, generation"]:::ok
    MAC ==> SET
    LOCKRT["🟠 lock applique au descripteur servi<br/>Module::descriptor engendre l'ignore"]:::todo
    LOCKCLI["✅ this descriptor export<br/>compose puis lock.apply"]:::ok
    LOCK ==> LOCKCLI
    LOCK -.->|"non branche a l'execution"| LOCKRT
    LOCKRT -.-> SET

    subgraph DER["this_descriptor::derive, pur, wasm32"]
        direction TB
        AT["✅ proto::assign_tags<br/>ordre des noms, append-only<br/>overlay = tag de base"]:::ok
        PR["✅ proto::entity_proto<br/>tri par tag, reserved 1..15 + retires"]:::ok
        GQ["✅ graphql::SdlBuilder<br/>optional = nullable, enums, inputs"]:::ok
        JS["✅ json_schema::write_schema<br/>required = payload_required, regle du moteur"]:::ok
        OA["✅ json_schema::openapi<br/>CRUD minimal 3.1, statuts 2XX"]:::ok
    end
    LOCK --> AT
    SET ==> PR
    SET ==> GQ
    SET ==> JS
    JS --> OA

    subgraph HOST["this-rs, lecture du catalogue vivant"]
        direction TB
        SG["✅ SchemaGenerator<br/>cache par Arc du set"]:::ok
        PG["✅ ProtoGenerator<br/>Lenient : champ sans tag commente"]:::ok
        EX["✅ GET /_this/descriptors, /schema, /openapi.json"]:::ok
    end
    AUTHZ["✅ Authorization::requirement<br/>/_this = Descriptor read, authenticated"]:::ok
    AUTHZ ==>|"garde, sinon 403 pour tous"| EX
    GQ ==> SG
    PR ==> PG
    JS ==> EX
    OA ==> EX
    SET ==> EX

    SAMPLE["⚠ repli sample JSON<br/>entites sans descripteur, tags instables"]:::trap
    SAMPLE -.->|"repli conserve"| SG
    SAMPLE -.->|"repli conserve"| PG
    MACTAG["🔴 tags attribues par la macro<br/>ordre de declaration = instable, RFC 3.3"]:::refused
    MACTAG -.- MAC
    WIRE["⚪ fil gRPC servi = Struct<br/>le .proto documente seulement"]:::upstream
    PG -.- WIRE

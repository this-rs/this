%% name: module-descriptor-runtime-layers
%% PROUVE : ordre des couches de RestExposure::build_router avec module runtime (tests/module_runtime.rs,
%%   admin_interface_requires_admin_then_lists_loads_unloads avec autorisation ARMEE ; dynamic_module_paths_not_shadowed_by_link_wildcards).
%% SOURCES LUES : src/server/exposure/rest/mod.rs, src/server/module_runtime/dispatch.rs (ModuleRuntime::mount), admin.rs.
%% NON ETABLI : GraphQL, gRPC et WebSocket ne voient pas les modules charges a chaud (flux auth, lecture du catalogue).
    REQ(["Requete HTTP"]):::entry --> CORS["✅ CORS, garde de domaine"]:::ok
    CORS --> AUTHN["✅ Authentification<br/>pose AuthContext"]:::ok
    AUTHN --> ADM{"✅ Interface admin<br/>/admin/modules, admin_only"}:::ok
    ADM -->|"autre chemin"| DSP{"✅ Couche de repartition<br/>DispatchTable, ArcSwap"}:::ok
    DSP -->|"pluriel runtime, 1-2 segments"| MOD["✅ Routeur du module<br/>JsonEntityService ou routes compilees"]:::ok
    DSP -->|"route de lien runtime"| LNK["✅ Routeur de liens de l'instantane<br/>config fusionnee strictement"]:::ok
    DSP -->|"Draining"| U503["✅ 503 this.module.unavailable"]:::ok
    DSP -->|"module decharge"| U404["✅ 404 this.module.not_found"]:::ok
    DSP ==>|"chemin statique"| AUTHZ["⚪ Autorisation historique<br/>table d'entites figee au build"]:::upstream
    AUTHZ ==> ROUTER["⚪ Router statique<br/>entites, liens, repli"]:::upstream
    DSP -.->|"politiques du descripteur<br/>evaluate, owner refuse"| POL["✅ Refus 401 ou 403"]:::ok
    AUTHZ -.->|"non prouve : migration flux auth"| CATAL["🟠 Lecture du LiveCatalog"]:::todo

